{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts/*.ts",
    "scripts/test/*.ts",
    "packages/edge/scripts/title-summarizer-openai-compatible.ts"
  ],
  "exclude": [
    "scripts/fixtures"
  ]
}
